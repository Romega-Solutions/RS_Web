{
  "version": 2,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/",
      "dest": "/pages/index.html"
    },
    {
      "src": "/about",
      "dest": "/pages/about.html"
    },
    {
      "src": "/services",
      "dest": "/pages/services.html"
    },
    {
      "src": "/careers",
      "dest": "/pages/careers.html"
    },
    {
      "src": "/contact",
      "dest": "/pages/contact.html"
    },
    {
      "src": "/resources",
      "dest": "/pages/resources.html"
    },
    {
      "src": "/(.*)\\.html$",
      "dest": "/pages/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/pages/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
