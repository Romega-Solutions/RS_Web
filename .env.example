# Environment Variables for Romega Solutions Website
# Copy this file to .env.local for development or .env.production for production

# ==============================================================================
# Application
# ==============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# ==============================================================================
# Database (Supabase)
# ==============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Email Service (Choose ONE)
# ==============================================================================

# Option 1: Resend (Recommended for production)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Option 2: EmailJS (Alternative)
# Get from: https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Option 3: SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@romegasolutions.com

# ==============================================================================
# Analytics
# ==============================================================================
# Google Analytics 4 - Get from: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# Security
# ==============================================================================
# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# API Security
API_SECRET_KEY=generate-a-random-secret-key-here

# ==============================================================================
# Monitoring & Observability (New)
# ==============================================================================
# Enable metrics collection
ENABLE_METRICS=true

# Prometheus metrics endpoint protection
METRICS_AUTH_TOKEN=generate-random-token-for-metrics-endpoint

# ==============================================================================
# Development Only
# ==============================================================================
# Disable security for local development (NEVER set to true in production)
DISABLE_SECURITY=false
