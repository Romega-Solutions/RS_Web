{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "dynamicImport": true
    },
    "target": "es2020",
    "loose": false,
    "externalHelpers": false,
    "keepClassNames": false,
    "transform": null,
    "minify": {
      "compress": true,
      "mangle": true
    }
  },
  "exclude": [
    "node_modules"
  ]
}
