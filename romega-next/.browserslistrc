# Modern browsers only - reduces legacy JavaScript significantly
# This targets ES2020+ capable browsers (95%+ of users)
# Reduces bundle size by 10-15% by avoiding unnecessary polyfills

# Production: Modern browsers
[production]
chrome >= 91
edge >= 91
firefox >= 90
safari >= 15
ios >= 15

# Development: Last 2 versions for testing
[development]
last 2 chrome versions
last 2 firefox versions
last 2 safari versions
last 2 edge versions
