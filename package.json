{
  "name": "romega-solutions-website",
  "version": "1.0.0",
  "description": "Romega Solutions website with honeypot anti-spam protection",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/js/test-setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/romega-next/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/romega-next/"
    ],
    "passWithNoTests": true
  }
}
