# Security Docker ignore file
# Prevents sensitive files from being included in Docker images

# Environment files (SECURITY CRITICAL)
.env
.env.*
!.env.example

# Git
.git
.gitignore
.github
.gitattributes

# Documentation
README.md
LICENSE
IMPLEMENTATION_GUIDE.md
SECURITY_GUIDE.md
SECURITY_IMPLEMENTATION.md
*.md
!docker-*.md

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Development
.vscode
.idea
*.swp
*.swo
*~
.editorconfig

# Testing (SECURITY: Don't include tests)
coverage
.nyc_output
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__
test-setup.js
jest.config.js
playwright.config.ts

# Build artifacts
.next
out
build
dist
*.log

# Prisma
prisma/migrations
prisma/*.db
prisma/*.db-journal

# Scripts (not needed in container)
scripts
script

# Development files (SECURITY: Don't include examples)
*.example.ts
*.example.js
*.example

# Sensitive data (SECURITY CRITICAL)
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets
credentials
*.secret

# Backup files
*.backup
*.bak
*.tmp
*.temp

# Docker files
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore

# OS files
.DS_Store
Thumbs.db
desktop.ini